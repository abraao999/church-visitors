{
  "name": "church-visitors",
  "private": true,
  "version": "1.3.0",
  "description": "Sistema de visitantes e pedidos de oração para igreja",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose stop mongo",
    "db:logs": "docker compose logs -f mongo",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "test": "npm test --prefix server && npm test --prefix client && npm run lint",
    "lint": "eslint client/src server/src --max-warnings 0",
    "build:vercel": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "tenancy:check": "npm run tenancy:check --prefix server",
    "tenancy:migrate": "npm run tenancy:migrate --prefix server --",
    "services:recurrence:check": "npm run services:recurrence:check --prefix server",
    "services:recurrence": "npm run services:recurrence --prefix server --",
    "guest-access:types": "npm run guest-access:types --prefix server --",
    "platform-admin:create": "npm run platform-admin:create --prefix server"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0",
    "resend": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  }
}
