# Copie para client/.env se precisar de variáveis públicas do Vite:
#   cp client/.env.example client/.env
#
# Variáveis expostas ao browser DEVEM usar o prefixo VITE_.
# Hoje o frontend funciona sem variáveis obrigatórias (API via proxy do Vite / deploy).

# Exemplo (descomente se for necessário no seu ambiente):
# VITE_API_BASE_URL=
