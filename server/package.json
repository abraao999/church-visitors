{
  "name": "church-visitors-server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "npm run build && node --test 'dist/**/*.test.js'",
    "start": "node dist/index.js",
    "tenancy:check": "tsx src/scripts/tenancy.ts check",
    "tenancy:migrate": "tsx src/scripts/tenancy.ts migrate",
    "services:recurrence:check": "tsx src/scripts/serviceRecurrence.ts check",
    "services:recurrence": "tsx src/scripts/serviceRecurrence.ts migrate",
    "guest-access:types": "tsx src/scripts/guestAccessTypes.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
