PORT=3001

# MongoDB Atlas — substitua pelos seus dados:
# 1. Crie um cluster em https://cloud.mongodb.com
# 2. Database Access → crie um usuário com senha
# 3. Network Access → adicione 0.0.0.0/0 (necessário para Vercel)
# 4. Connect → Drivers → copie a connection string
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/church-visitors?retryWrites=true&w=majority&appName=church-visitors

# Autenticação
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Google Sign-In (OAuth Client ID do tipo "Aplicativo da Web")
# https://console.cloud.google.com/apis/credentials
# Em produção, autorize também https://SEU-PROJETO.vercel.app
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
