# Copie para server/.env:
#   cp server/.env.example server/.env
#
# Em produção (Vercel), configure as mesmas variáveis no painel do projeto.

PORT=3002

# MongoDB
# - Local: mongodb://localhost:27017/church-visitors
# - Atlas (SRV): mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/church-visitors?retryWrites=true&w=majority&appName=church-visitors
# - Atlas (standard, evita erro querySrv em alguns Windows):
#   mongodb://USUARIO:SENHA@host1:27017,host2:27017,host3:27017/church-visitors?ssl=true&authSource=admin&replicaSet=...&retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/church-visitors

# Só ligue se o Windows não resolver mongodb+srv (erro querySrv). Na Vercel deixe desligado.
# MONGODB_DNS_OVERRIDE=1

# Autenticação JWT (obrigatória: sem ela o login e as telas internas não funcionam)
# Deve ter pelo menos 32 caracteres, ser DIFERENTE do GUEST_ACCESS_SECRET
# e NÃO pode ficar com o valor de exemplo abaixo.
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria-jwt-32+

# Acessos convidados por link/QR (obrigatória para /acessos e /acesso/:token)
# Deve ter pelo menos 32 caracteres, ser DIFERENTE do JWT_SECRET
# e NÃO pode ficar com o valor de exemplo abaixo.
# Gere com: openssl rand -hex 32
GUEST_ACCESS_SECRET=troque-por-outra-chave-longa-e-aleatoria-guest-32+

# Protege a rotina diária de retenção de dados na Vercel.
# Não use o valor de exemplo. Gere com: openssl rand -hex 32
CRON_SECRET=troque-por-uma-chave-longa-e-aleatoria-cron-32+

# Quantos proxies existem na frente do servidor. Necessário para o limite dos
# formulários públicos contar o IP real do visitante. Na Vercel já vale 1
# automaticamente; preencha só se usar outro proxy (Nginx, Cloudflare etc.).
# TRUST_PROXY=1

# Origem do site (CORS). Na Vercel o endereço do deploy entra sozinho.
# Use se tiver domínio próprio, separado por vírgula se houver mais de um:
# APP_ORIGIN=https://app.suaigreja.com

# Armazenamento do logotipo da igreja (Vercel Blob).
# Obrigatória para enviar logotipo. Na Vercel: Storage → Create Database → Blob
# e conecte o projeto. Em desenvolvimento local, copie o token do painel.
# BLOB_READ_WRITE_TOKEN=

# Opcionais (preenchidas automaticamente em ambientes específicos)
# NODE_ENV=development
# VERCEL=1
