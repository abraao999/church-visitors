# Variáveis do backend ficam em server/.env
# Use:
#   cp server/.env.example server/.env
#
# Variáveis do frontend (opcionais) ficam em client/.env
# Use:
#   cp client/.env.example client/.env
#
# Este arquivo na raiz é só um lembrete — o servidor carrega dotenv a partir de server/.
#
# Variáveis de e-mail (somente servidor; nunca VITE_):
#   RESEND_API_KEY=
#   EMAIL_FROM=Eclesiafy <acesso@notificacoes.eclesiafy.com.br>
#   EMAIL_REPLY_TO=
#   APP_ORIGIN=https://app.eclesiafy.com.br
#   EMAIL_TOKEN_SECRET=
#   EMAIL_VERIFICATION_TTL_MINUTES=30
#   PASSWORD_RESET_TTL_MINUTES=30
#   EMAIL_RESEND_INTERVAL_SECONDS=60
#   EMAIL_CODE_MAX_ATTEMPTS=5
